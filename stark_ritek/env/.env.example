# Sao chép thành `env/.env` rồi điền giá trị thật. `env/.env` đã bị .gitignore chặn.
# Không commit key.

# ---------------------------------------------------------------------------
# LLM / Embedding API (client tương thích OpenAI — người dùng sẽ cung cấp)
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=                       # model cho reranking / planning / filtering
EMBED_BASE_URL=                  # để trống nếu dùng chung LLM_BASE_URL
EMBED_API_KEY=
EMBED_MODEL=                     # vd: text-embedding-3-small
EMBED_DIM=                       # vd: 1536 — dùng để preallocate ma trận embedding

# Giới hạn tốc độ để không vượt quota của host
LLM_MAX_CONCURRENCY=8
EMBED_MAX_CONCURRENCY=16
EMBED_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# Kaggle (chạy training / model cần GPU). scripts/kaggle_run.py dùng MỌI cặp
# KAGGLE_USERNAME_<X>/KAGGLE_KEY_<X> làm pool slot GPU (1 job/account), theo thứ tự trong file.
# Bỏ account khỏi pool = comment cặp đó. Cặp có username mà thiếu key -> báo lỗi.
# ---------------------------------------------------------------------------
KAGGLE_USERNAME_ACC1=
KAGGLE_KEY_ACC1=

KAGGLE_USERNAME_ACC2=
KAGGLE_KEY_ACC2=

KAGGLE_USERNAME_ACC3=
KAGGLE_KEY_ACC3=

# ---------------------------------------------------------------------------
# Đường dẫn
# ---------------------------------------------------------------------------
STARK_DATA_ROOT=data/stark/prime
RESULTS_ROOT=results
CACHE_ROOT=.cache                # embedding, document đã dựng, chỉ mục BM25

# ---------------------------------------------------------------------------
# HuggingFace (tải raw/ của STaRK nếu cần, tải base model Llama-3.2-3B cho MoR)
# ---------------------------------------------------------------------------
HF_TOKEN=
