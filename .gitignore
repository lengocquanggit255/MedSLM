# secrets
env/.env
*.key

# data & artefacts
.cache/
**/predictions.parquet
results/kaggle/
ritek/outputs/
data/ritek/
share/
*.npy
*.npz
*.pt
*.pkl
*.zip
*.pth
*.safetensors
!data/stark/prime/processed/*.pkl

# python
__pycache__/
*.pyc
.venv*/
venvs/
*.egg-info/

# misc
.ipynb_checkpoints/
.DS_Store

# enrichment raw sources (lớn, tải lại được bằng scripts/enrich_download.py)
data/enrich/sources/**/*
!data/enrich/sources/manifest.json

# HOP: dữ liệu/trọng số đầu vào, gói Kaggle và bản sao tokenizer đều sinh lại được
HOP/__MACOSX/
HOP/*/inputs/*
!HOP/*/inputs/input_manifest.json
HOP/*/kaggle/package/
HOP/*/replay_setting_b*/tokenizer_compat/
HOP/*/replay_setting_b*/test_predictions.jsonl

# Tạm thời (2026-10-27): chỉ commit những gì thuộc HOP. Mọi thứ khác ở gốc repo bị bỏ qua;
# file đã được git theo dõi từ trước (src/, scripts/, ritek/, ...) vẫn được theo dõi như cũ.
CLAUDE.md
/*
!/.gitignore
!/HOP/
